 /**
+ * Win7 offline port: resolve the PortableGit bash.exe shipped inside the
+ * installer's runtime payload. Probes, in order:
+ *
+ *   1. CC_HAHA_BASH_EXE            — explicit bash.exe override
+ *   2. CC_HAHA_RUNTIME_DIR/git/…   — runtime dir override
+ *   3. <dist>/../runtime/git/…     — portable layout (package/dist + runtime)
+ *   4. <dist>/../../runtime/git/…  — installer layout
+ *                                    (resources/app.asar.unpacked/dist +
+ *                                     resources/runtime)
+ *
+ * In the bundled dist this module lives next to cli.mjs/server.mjs, so the
+ * relative probes land on the payload's runtime tree. In the source tree the
+ * probes simply miss and return null.
+ */
+export function findBundledGitBashPath(
+  env: NodeJS.ProcessEnv = process.env,
+  distDir: string = defaultBundledDistDir(),
+  fileExists: (filePath: string) => boolean = bundledFileExists,
+): string | null {
+  const candidates = [
+    env.CC_HAHA_BASH_EXE?.trim() || undefined,
+    env.CC_HAHA_RUNTIME_DIR
+      ? pathWin32.join(env.CC_HAHA_RUNTIME_DIR, 'git', 'bin', 'bash.exe')
+      : undefined,
+    pathWin32.join(distDir, '..', 'runtime', 'git', 'bin', 'bash.exe'),
+    pathWin32.join(distDir, '..', '..', 'runtime', 'git', 'bin', 'bash.exe'),
+  ]
+  for (const candidate of candidates) {
+    if (candidate && fileExists(candidate)) return candidate
+  }
+  return null
+}
+
+function defaultBundledDistDir(): string {
+  try {
+    return path.dirname(fileURLToPath(import.meta.url))
+  } catch {
+    return process.cwd()
+  }
+}
+
+function bundledFileExists(filePath: string): boolean {
+  try {
+    return statSync(filePath).isFile()
+  } catch {
+    return false
+  }
+}
