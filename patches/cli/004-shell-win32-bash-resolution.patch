+export function findBundledGitBashPath(
+  env: NodeJS.ProcessEnv = process.env,
+  distDir: string = defaultBundledDistDir(),
+  fileExists: (filePath: string) => boolean = bundledFileExists,
+): string | null {
+  const candidates = [
+    env.CC_HAHA_BASH_EXE?.trim() || undefined,
+    env.CC_HAHA_RUNTIME_DIR
+      ? pathWin32.join(env.CC_HAHA_RUNTIME_DIR, 'git-2.45.2', 'bin', 'bash.exe')
+      : undefined,
+    pathWin32.join(distDir, '..', 'runtime', 'git-2.45.2', 'bin', 'bash.exe'),
+    pathWin32.join(distDir, '..', '..', 'runtime', 'git-2.45.2', 'bin', 'bash.exe'),
+  ]
+  for (const candidate of candidates) {
+    if (candidate && fileExists(candidate)) return candidate
+  }
+  return null
+}
+
+function defaultBundledDistDir(): string {
+  try {
+    return path.dirname(fileURLToPath(import.meta.url))
+  } catch {
+    return process.cwd()
+  }
+}
+
+function bundledFileExists(filePath: string): boolean {
+  try {
+    return statSync(filePath).isFile()
+  } catch {
+    return false
+  }
+}
