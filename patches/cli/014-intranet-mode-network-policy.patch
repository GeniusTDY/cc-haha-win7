+/**
+ * Broadcast an intranet-mode toggle to every connected client, so open
+ * windows re-read the policy immediately (hide/show online components,
+ * refresh the settings switch) without waiting for a reload. The CLI side
+ * needs no push: tools re-read the uncached flag per call.
+ */
+export function broadcastNetworkPolicyChanged(intranetMode: boolean): void {
+  const message: ServerMessage = {
+    type: 'network_policy_changed',
+    intranetMode,
+  }
+  for (const sockets of activeSessions.values()) {
+    for (const ws of sockets) {
+      if (ws.data.channel === 'client') {
+        sendMessage(ws, message)
+      }
+    }
+  }
+}
