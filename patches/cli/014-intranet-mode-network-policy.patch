diff --git a/src/utils/networkPolicy.ts b/src/utils/networkPolicy.ts
new file mode 100644
index 0000000..a35ece7
--- /dev/null
+++ b/src/utils/networkPolicy.ts
@@ -0,0 +1,67 @@
+/**
+ * Intranet mode — runtime policy gate.
+ *
+ * A single boolean in the user settings file (`intranetMode`) switches the
+ * whole app into an air-gapped posture: no outbound telemetry, no OAuth
+ * login flows, no update checks, WebSearch disabled with an explicit
+ * message to the model, and WebFetch stripped of its internet-facing
+ * preflights (domain blocklist + http→https upgrade) so plain-http
+ * intranet services stay fetchable.
+ *
+ * The flag lives in ~/.claude/settings.json — written by the desktop
+ * settings UI through the server's PUT /api/settings/user — so every
+ * process sharing that file observes the same policy. Reads are
+ * deliberately UNCACHED: a running CLI session must pick up a toggle
+ * flip on the very next tool call, without a restart (switching the
+ * toggle affects already-open sessions).
+ */
+
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+export const INTRANET_MODE_SETTINGS_KEY = 'intranetMode'
+
+function readIntranetModeFromFile(env: NodeJS.ProcessEnv): boolean | null {
+  const configDir = env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), '.claude')
+  const settingsPath = path.join(configDir, 'settings.json')
+  let raw: string
+  try {
+    raw = fs.readFileSync(settingsPath, 'utf8')
+  } catch {
+    return null
+  }
+  try {
+    const parsed = JSON.parse(raw) as Record<string, unknown>
+    return parsed?.[INTRANET_MODE_SETTINGS_KEY] === true ? true
+      : parsed?.[INTRANET_MODE_SETTINGS_KEY] === false ? false
+        : null
+  } catch {
+    return null
+  }
+}
+
+/**
+ * True when intranet mode is active.
+ *
+ * Resolution order:
+ *   1. ~/.claude/settings.json `intranetMode` (authoritative — flips take
+ *      effect immediately in running sessions)
+ *   2. CC_HAHA_INTRANET_MODE env ('1'/'0') — stamped on CLI children by the
+ *      server at spawn time; only consulted when the settings file is
+ *      unreadable, e.g. tests / stripped environments
+ */
+export function isIntranetModeEnabled(env: NodeJS.ProcessEnv = process.env): boolean {
+  const fromFile = readIntranetModeFromFile(env)
+  if (fromFile !== null) return fromFile
+  return env.CC_HAHA_INTRANET_MODE === '1'
+}
+
+/**
+ * Error message surfaced to the MODEL when it tries to use WebSearch under
+ * intranet mode. The model needs an actionable explanation, not a bare
+ * "disabled" — it should stop retrying the tool for this session.
+ */
+export const INTRANET_MODE_WEBSEARCH_DISABLED_MESSAGE =
+  'WebSearch is unavailable: intranet mode is enabled (内网模式已禁用 WebSearch). ' +
+  'Do not retry; answer from the conversation and local files instead.'
