+function createPipePtyFactory(): TerminalPtyFactory {
+  return {
+    spawn(shell: string, args: string[], options: TerminalPtySpawnOptions) {
+      const child = childSpawn(shell, args, {
+        cwd: options.cwd,
+        env: options.env,
+        stdio: ['pipe', 'pipe', 'pipe'],
+        windowsHide: true,
+      })
+      const dataListeners: Array<(data: string) => void> = []
