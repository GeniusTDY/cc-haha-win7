+++ b/desktop/src/pages/settings/IntranetModeSettings.tsx
@@ -0,0 +1,66 @@
+import { useSettingsStore } from '../../stores/settingsStore'
+import { useTranslation } from '../../i18n'
+import { useUIStore } from '../../stores/uiStore'
+import { SettingsPageHeader } from '@/components/settings/SettingsSection'
+import { SETTINGS_CHECKBOX_INPUT_CLASS, SettingsCheckboxMark } from './shared'
+
+/**
+ * 内网模式独立设置页（设置侧边栏第一项）。
+ *
+ * The air-gap master switch, promoted from GeneralSettings to its own rail
+ * entry so it is reachable in one click. The store logic is unchanged:
+ * optimistic update + rollback in settingsStore, server persists and
+ * broadcasts network_policy_changed so every open window (and CLI sessions)
+ * follows the flip without a restart.
+ */
+export function IntranetModeSettings() {
+  const t = useTranslation()
+  const intranetMode = useSettingsStore((s) => s.intranetMode)
+  const setIntranetMode = useSettingsStore((s) => s.setIntranetMode)
+  const addToast = useUIStore((s) => s.addToast)
+
+  // 乐观更新 + 失败回滚由 store 完成，这里只提示保存失败。
+  const handleIntranetModeToggle = async (enabled: boolean) => {
+    try {
+      await setIntranetMode(enabled)
+    } catch (error) {
+      addToast({
+        type: 'error',
+        message: error instanceof Error ? error.message : String(error),
+      })
+    }
+  }
+
+  return (
+    <div className="w-full min-w-0">
+      <SettingsPageHeader
+        title={t('settings.general.intranetModeTitle')}
+        description={t('settings.general.intranetModeDescription')}
+      />
+
+      {/* 空气隔离总开关 */}
+      <div className="mt-2">
+        <label className="relative flex items-start gap-3 rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface-container-low)] px-4 py-3 cursor-pointer hover:border-[var(--color-border-focus)] transition-colors">
+          <input
+            type="checkbox"
+            aria-label={t('settings.general.intranetModeEnabled')}
+            checked={intranetMode}
+            onChange={(e) => void handleIntranetModeToggle(e.target.checked)}
+            className={SETTINGS_CHECKBOX_INPUT_CLASS}
+          />
+          <SettingsCheckboxMark checked={intranetMode} />
+          <div className="min-w-0">
+            <div className="text-sm font-medium text-[var(--color-text-primary)]">
+              {t('settings.general.intranetModeEnabled')}
+            </div>
+            <div className="text-xs text-[var(--color-text-tertiary)] mt-1 leading-5">
+              {intranetMode
+                ? t('settings.general.intranetModeHintOn')
+                : t('settings.general.intranetModeHintOff')}
+            </div>
+          </div>
+        </label>
+      </div>
+    </div>
+  )
+}

