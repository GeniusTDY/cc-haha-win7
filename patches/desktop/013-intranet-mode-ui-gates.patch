+export const INTRANET_PROXY_TARGET_BLOCKED_MESSAGE =
+  'Intranet mode is enabled: public-internet proxy targets are blocked (内网模式已拦截外网代理目标)'
+
+export function isPrivateNetworkAddress(address: string): boolean {
+  const value = stripIpv6Brackets(address).toLowerCase()
+  if (value.includes(':')) {
+    return value === '::1' || value.startsWith('fe80:') || value.startsWith('fc') || value.startsWith('fd')
+  }
+  const octets = value.split('.')
+  if (octets.length !== 4) return false
+  const [first, second] = octets.map(Number)
+  if (first === 0 || first === 10 || first === 127) return true
+  if (first === 172 && second >= 16 && second <= 31) return true
+  if (first === 192 && second === 168) return true
+  return first === 169 && second === 254
+}
+
+async function lookupAllAddresses(hostname: string): Promise<string[]> {
+  const results = await lookup(hostname, { all: true })
+  return results.map(result => result.address)
+}
+
+export async function isIntranetProxyTargetAllowed(
+  hostname: string,
+  isIntranetMode: () => boolean,
+  resolveHost: (hostname: string) => Promise<string[]> = lookupAllAddresses,
+): Promise<boolean> {
+  if (!isIntranetMode()) return true
+  const host = stripIpv6Brackets(hostname).toLowerCase()
+  if (!host) return false
+  if (isLoopbackHostname(host)) return true
+  if (net.isIP(host)) return isPrivateNetworkAddress(host)
+  try {
+    const addresses = await resolveHost(host)
+    return addresses.length > 0 && addresses.every(isPrivateNetworkAddress)
+  } catch {
+    return false
+  }
+}
