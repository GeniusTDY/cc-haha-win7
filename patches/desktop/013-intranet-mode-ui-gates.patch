diff --git a/desktop/electron/services/intranetMode.ts b/desktop/electron/services/intranetMode.ts
new file mode 100644
index 0000000..4e32a91
--- /dev/null
+++ b/desktop/electron/services/intranetMode.ts
@@ -0,0 +1,44 @@
+import { readFileSync } from 'node:fs'
+import { homedir } from 'node:os'
+import path from 'node:path'
+
+/**
+ * Intranet mode (内网模式) — electron main-process reader.
+ *
+ * The authoritative flag lives in `<CLAUDE_CONFIG_DIR>/settings.json`
+ * (default `~/.claude/settings.json`) — the same user-settings file the
+ * server's PUT /api/settings/user writes and the CLI-side
+ * `src/utils/networkPolicy.ts` reads. The main process cannot import that
+ * server source (it lives outside the desktop project), so this tiny reader
+ * mirrors its resolution: config-dir override first, then the home fallback.
+ *
+ * Reads are deliberately UNCACHED: openExternalUrl / checkForUpdates call
+ * this per invocation, so flipping the toggle in any window takes effect in
+ * the main process immediately, without an app restart.
+ */
+
+export function intranetModeSettingsPath(
+  env: NodeJS.ProcessEnv = process.env,
+  homeDir: string = homedir(),
+): string {
+  const configDir = env.CLAUDE_CONFIG_DIR || path.join(homeDir, '.claude')
+  return path.join(configDir, 'settings.json')
+}
+
+export function isIntranetModeEnabled(
+  env: NodeJS.ProcessEnv = process.env,
+  homeDir: string = homedir(),
+): boolean {
+  let raw: string
+  try {
+    raw = readFileSync(intranetModeSettingsPath(env, homeDir), 'utf8')
+  } catch {
+    return false
+  }
+  try {
+    const parsed = JSON.parse(raw) as Record<string, unknown>
+    return parsed?.intranetMode === true
+  } catch {
+    return false
+  }
+}

diff --git a/desktop/electron/services/intranetNetworkGuard.ts b/desktop/electron/services/intranetNetworkGuard.ts
new file mode 100644
index 0000000..d773c3b
--- /dev/null
+++ b/desktop/electron/services/intranetNetworkGuard.ts
@@ -0,0 +1,58 @@
+import { isIntranetModeEnabled } from './intranetMode'
+
+type ElectronCommandLine = {
+  appendSwitch(name: string, value?: string): void
+}
+
+type SpellCheckerSession = {
+  setSpellCheckerEnabled(enabled: boolean): void
+  setSpellCheckerDictionaryDownloadURL(url: string): void
+}
+
+type ElectronAppForChromiumGuard = {
+  commandLine: ElectronCommandLine
+  on(event: 'session-created', listener: (session: SpellCheckerSession) => void): unknown
+  whenReady(): PromiseLike<void>
+}
+
+/**
+ * Fail-safe sink for Chromium's hunspell dictionary downloads: loopback can
+ * never leave the machine, so even a download attempt that survives the
+ * spellchecker disable below stays on-host (fails with 404/refused).
+ */
+export const INTRANET_SPELLCHECK_DICTIONARY_SINK_URL = 'http://127.0.0.1/dictionaries/'
+
+/**
+ * Intranet mode: Chromium's built-in background networking phones home
+ * entirely independent of app code (observed as SYN_SENT from the
+ * NetworkService process). Two layers are needed:
+ *
+ * 1. Component updater / background networking — disabled via Chromium
+ *    switches that must be appended before the app is ready, so this guard
+ *    runs once at main-process start. A mid-session intranet-mode toggle
+ *    therefore takes effect for these switches on the next app launch.
+ * 2. Spellchecker — Chromium downloads missing hunspell dictionaries from
+ *    redirector.gvt1.com (Google CDN) and retries every ~5 minutes; the
+ *    component-update switches do not cover it, and disabling the checker
+ *    alone still leaves one startup download attempt. The spellchecker is
+ *    disabled per session AND the download URL is repointed at loopback,
+ *    which is live for sessions created after the toggle.
+ *
+ * All app-level gates (OAuth, telemetry, updater, external links) stay live.
+ */
+export function installIntranetChromiumNetworkGuard(
+  app: ElectronAppForChromiumGuard,
+  getDefaultSession: () => SpellCheckerSession,
+  isIntranetMode: () => boolean = isIntranetModeEnabled,
+): boolean {
+  if (!isIntranetMode()) return false
+  app.commandLine.appendSwitch('disable-component-update')
+  app.commandLine.appendSwitch('disable-background-networking')
+  const disableSpellChecker = (ses: SpellCheckerSession) => {
+    ses.setSpellCheckerEnabled(false)
+    ses.setSpellCheckerDictionaryDownloadURL(INTRANET_SPELLCHECK_DICTIONARY_SINK_URL)
+  }
+  app.on('session-created', disableSpellChecker)
+  void Promise.resolve(app.whenReady()).then(() => disableSpellChecker(getDefaultSession()))
+  return true
+}

