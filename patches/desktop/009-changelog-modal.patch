diff --git a/desktop/src/lib/changelogContent.ts b/desktop/src/lib/changelogContent.ts
new file mode 100644
index 0000000..76cfb84
--- /dev/null
+++ b/desktop/src/lib/changelogContent.ts
@@ -0,0 +1,73 @@
+/**
+ * Fixed, pre-baked changelog content for the About panel's release-notes
+ * modal (round50 rewrite). The corpus lives in changelogContentData.ts
+ * (generated): one entry per upstream (NanmiCoder/cc-haha) release, holding
+ * the exact Markdown the modal displays per language — the bilingual split
+ * and the Installation-section removal were baked in at generation time, so
+ * rendering is a pure lookup. What still happens at render time:
+ *
+ *   - language mapping + fallback: zhBody for the Simplified-Chinese locale,
+ *     enBody for every other locale (zh-TW included); a null bucket (upstream
+ *     shipped no such section) falls back to the other language, so a
+ *     monolingual release body still renders a non-empty modal
+ *   - issue-reference linkification: bare `#1190` refs become links to the
+ *     upstream issue tracker (linkUpstreamIssueRefs, unchanged logic)
+ */
+import { CHANGELOG_CONTENT_DATA } from './changelogContentData'
+
+export type ChangelogEntryData = {
+  /** App version this entry documents (upstream tag = `v${version}`). */
+  version: string
+  /** Chinese section (Installation removed) — null when upstream shipped none. */
+  zhBody: string | null
+  /** English section (Installation removed) — null when upstream shipped none. */
+  enBody: string | null
+  /** Upstream release page for this tag. */
+  upstreamUrl: string
+}
+
+export const CHANGELOG_CONTENT: readonly ChangelogEntryData[] = CHANGELOG_CONTENT_DATA
+
+/**
+ * All bundled versions, newest-first (the generated corpus order) — the
+ * changelog modal's version switcher lists these.
+ */
+export function listChangelogVersions(): readonly string[] {
+  return CHANGELOG_CONTENT.map((entry) => entry.version)
+}
+
+export function getChangelogEntry(appVersion: string): ChangelogEntryData | null {
+  return CHANGELOG_CONTENT.find((entry) => entry.version === appVersion) ?? null
+}
+
+/**
+ * Picks the body to display for a locale, with the fallback chain: prefer
+ * the locale's language bucket, fall back to the other one when upstream
+ * didn't ship it (monolingual release body).
+ */
+export function resolveChangelogBody(entry: ChangelogEntryData, locale: string): string | null {
+  return locale === 'zh' ? entry.zhBody ?? entry.enBody : entry.enBody ?? entry.zhBody
+}
+
+/**
+ * Rewrites bare upstream issue references (`#1190`) into Markdown links to the
+ * upstream repository's issue tracker. GitHub renders these automatically on
+ * release pages, but the baked body is plain text, so the same convenience
+ * has to be restored here before the modal renders it.
+ *
+ * Guards: a `#` must be followed by digits (headings use `# ` and never
+ * match), and references already inside link text `[#123](…)` or a link
+ * destination `](#123)` are skipped so a re-run never nests links. Plain
+ * prose parens `(#123)` still linkify — only `](` counts as a destination.
+ * Code spans and fenced blocks are matched ahead of the issue alternative and
+ * returned verbatim: `` `#123` `` is example text, and linkifying it would
+ * leave the literal `[#123](url)` visible inside the code span.
+ */
+export function linkUpstreamIssueRefs(text: string, entry: ChangelogEntryData): string {
+  const repoUrl = entry.upstreamUrl.replace(/\/releases\/.*$/, '')
+  return text.replace(
+    /```[\s\S]*?```|`[^`\n]*`|((?<!\[)(?<!\]\()#\d+\b)/g,
+    (match, issue?: string) =>
+      issue ? `[${issue}](${repoUrl}/issues/${issue.slice(1)})` : match
+  )
+}
