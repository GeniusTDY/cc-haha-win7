From: Win7 port restore
Subject: [PATCH] desktop: refresh providers when the server reports providers_changed

Importing or updating a provider in one window left every other open
window (and the settings page) showing a stale provider list until a
manual reload. The server already emits a providers_changed event per
mutation (created / updated / deleted / activated / reordered /
imported) - the desktop just never listened.

chatStore now handles providers_changed by scheduling a 500 ms-debounced
useProviderStore.fetchProviders(), so bursty multi-event imports collapse
into a single refetch. The flush is scheduled directly from chatStore
(which already imports useProviderStore) rather than through a handler
registered at providerStore's module top level: that top-level register
call evaluated while chatStore's handler binding was still in its
temporal dead zone across the chatStore <-> providerStore import cycle,
throwing "Cannot access 'providersChangedHandler' before initialization"
and tearing down the store graph under the test runner.

diff --git a/desktop/src/stores/chatStore.ts b/desktop/src/stores/chatStore.ts
index 98f5610e1..a22b31617 100644
--- a/desktop/src/stores/chatStore.ts
+++ b/desktop/src/stores/chatStore.ts
@@ -50,6 +50,15 @@ import type {
   SlashCommandSource,
 } from '../types/slashCommand'
 
+let providersChangedFlushTimer: ReturnType<typeof setTimeout> | null = null
+function scheduleProvidersRefresh(): void {
+  if (providersChangedFlushTimer !== null) return
+  providersChangedFlushTimer = setTimeout(() => {
+    providersChangedFlushTimer = null
+    void useProviderStore.getState().fetchProviders()
+  }, 500)
+}
+
 type ConnectionState = 'disconnected' | 'connecting' | 'connected' | 'reconnecting'
 
 function reconcileProviderRuntimeSelection(selection: RuntimeSelection): RuntimeSelection {
@@ -4390,6 +4399,11 @@ export const useChatStore = create<ChatStore>((set, get) => ({
         break
       }
 
+      case 'providers_changed': {
+        scheduleProvidersRefresh()
+        break
+      }
+
       case 'content_start': {
         const session = get().sessions[sessionId]
         if (!session) break
