+
+let providersChangedFlushTimer: ReturnType<typeof setTimeout> | null = null
+registerProvidersChangedHandler(() => {
+  if (providersChangedFlushTimer !== null) return
+  providersChangedFlushTimer = setTimeout(() => {
+    providersChangedFlushTimer = null
+    void useProviderStore.getState().fetchProviders()
+  }, 500)
+})
