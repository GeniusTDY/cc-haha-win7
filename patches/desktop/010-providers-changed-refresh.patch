From: Win7 port restore
Subject: [PATCH] desktop: refresh providers when the server reports providers_changed

Importing or updating a provider in one window left every other open
window (and the settings page) showing a stale provider list until a
manual reload. The server already emits a providers_changed event per
mutation (created / updated / deleted / activated / reordered /
imported) — the desktop just never listened.

chatStore now exposes registerProvidersChangedHandler() and dispatches
the event's reason; providerStore registers a 500 ms-debounced
fetchProviders() flush on it, so bursty multi-event imports collapse
into a single refetch. Provider tests mock the new export.

diff --git a/desktop/src/stores/chatStore.ts b/desktop/src/stores/chatStore.ts
index 98f5610e1..d6fb9da06 100644
--- a/desktop/src/stores/chatStore.ts
+++ b/desktop/src/stores/chatStore.ts
@@ -50,6 +50,18 @@ import type {
   SlashCommandSource,
 } from '../types/slashCommand'
 
+type ProvidersChangedHandler = (reason: 'created' | 'updated' | 'deleted' | 'activated' | 'reordered' | 'imported') => void
+let providersChangedHandler: ProvidersChangedHandler | null = null
+export function registerProvidersChangedHandler(handler: ProvidersChangedHandler | null): void {
+  providersChangedHandler = handler
+}
+function notifyProvidersChangedListeners(reason: Parameters<ProvidersChangedHandler>[0]): void {
+  try {
+    providersChangedHandler?.(reason)
+  } catch {
+  }
+}
+
 type ConnectionState = 'disconnected' | 'connecting' | 'connected' | 'reconnecting'
 
