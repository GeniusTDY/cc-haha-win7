diff --git a/desktop/src/lib/sessionTitle.ts b/desktop/src/lib/sessionTitle.ts
index 031f4788..5bc0aade 100644
--- a/desktop/src/lib/sessionTitle.ts
+++ b/desktop/src/lib/sessionTitle.ts
@@ -46,3 +46,19 @@ export function deriveSessionTitle(raw: string): string | null {
 export function isPlaceholderSessionTitle(title: string | null | undefined): boolean {
   return PLACEHOLDER_TITLES.has((title ?? '').trim())
 }
+
+/**
+ * Map a stored session title to its display form.
+ *
+ * Placeholder titles ('', 'New Session', 'Untitled Session') are store/server
+ * sentinels shared by all locales, not user-facing copy — rendering them raw
+ * leaks English into localized UIs. Display sites should pass the localized
+ * fallback; the data layer keeps the sentinel untouched so auto-naming,
+ * title-merge protection, and empty-session cleanup keep working.
+ */
+export function displaySessionTitle(
+  title: string | null | undefined,
+  localizedFallback: string,
+): string {
+  return isPlaceholderSessionTitle(title) ? localizedFallback : (title as string)
+}
